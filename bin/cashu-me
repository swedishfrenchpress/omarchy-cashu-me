#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
omarchy_shell=${OMARCHY_PATH:-/usr/share/omarchy}/shell
runtime_dir=${XDG_CACHE_HOME:-$HOME/.cache}/cashu-me/ui
export CASHU_ME_BACKEND="$project_dir/target/debug/cashu-me-wallet"
if [[ -x $project_dir/target/release/cashu-me-wallet ]]; then
  export CASHU_ME_BACKEND="$project_dir/target/release/cashu-me-wallet"
fi
export CASHU_ME_SCANNER="$project_dir/bin/scan-qr"
export CASHU_ME_PREVIEW=0
export CASHU_ME_WINDOW=0
export CASHU_ME_ANIMATE=0
export CASHU_ME_ANCHOR_X=${3:--1}
export CASHU_ME_SCREEN=${2:-}
ipc_method=show
ipc_args=()
if [[ ${1:-} == "--window" ]]; then
  export CASHU_ME_WINDOW=1
  ipc_method=expand
elif [[ ${1:-} == "--toggle" ]]; then
  export CASHU_ME_ANIMATE=1
  ipc_method=toggleAt
  ipc_args=("$CASHU_ME_SCREEN" "$CASHU_ME_ANCHOR_X")
fi
if [[ ${1:-} == "--preview" || ${1:-} == "--check" ]]; then
  export CASHU_ME_PREVIEW=1
  runtime_dir=${XDG_CACHE_HOME:-$HOME/.cache}/cashu-me/preview
fi

# Checked before the dispatch below, which execs quickshell directly: without
# this a missing binary reports "command not found" instead of the cause.
command -v quickshell >/dev/null || { echo 'Missing dependency: quickshell' >&2; exit 1; }

# Status and quit must never copy files into a running QML configuration.
case ${1:-} in
  --quit) exec quickshell ipc -p "$runtime_dir" call -- wallet quit ;;
  --status) exec quickshell ipc -p "$runtime_dir" call -- wallet status ;;
  --check|--preview|--window|--toggle|"") ;;
  *) echo 'Usage: cashu-me [--window|--toggle [screen]|--preview|--status|--quit|--check]' >&2; exit 2 ;;
esac

# Reopening must not hot-reload a running wallet or interrupt its worker.
if [[ ${1:-} != "--check" ]] && quickshell ipc -p "$runtime_dir" call -- wallet "$ipc_method" "${ipc_args[@]}" >/dev/null 2>&1; then
  exit 0
fi
# An older running UI may not implement a newly added presentation method.
# Never mistake that for an absent instance and hot-reload a live wallet.
if [[ ${1:-} != "--check" ]] && quickshell ipc -p "$runtime_dir" call -- wallet status >/dev/null 2>&1; then
  echo 'cashu.me is already running. Quit and reopen it to load this update.' >&2
  exit 1
fi

for dependency in quickshell inotifywait; do
  command -v "$dependency" >/dev/null || { echo "Missing dependency: $dependency" >&2; exit 1; }
done
for module in Commons Ui; do
  test -f "$omarchy_shell/$module/qmldir" || { echo "Omarchy UI module missing: $module" >&2; exit 1; }
done

umask 077
mkdir -p "$runtime_dir"
cp "$project_dir/data/suggested-mints.json" "$runtime_dir/suggested-mints.json"
ln -sfn "$omarchy_shell/Commons" "$runtime_dir/Commons"
ln -sfn "$omarchy_shell/Ui" "$runtime_dir/Ui"
# Quickshell exposes modules below its config root through the qs.* namespace.
# Keep packaged Omarchy files untouched and use a private runtime config.
# nullglob: an unmatched pattern would otherwise reach cp and abort under set -e.
shopt -s nullglob
for source_file in "$project_dir"/ui/*.qml "$project_dir"/ui/*.js; do
  destination="$runtime_dir/$(basename -- "$source_file")"
  if ! cmp -s "$source_file" "$destination"; then cp "$source_file" "$destination"; fi
done
# Drop copies of files since deleted from ui/; quickshell would still load them.
for cached in "$runtime_dir"/*.qml "$runtime_dir"/*.js; do
  test -f "$project_dir/ui/$(basename -- "$cached")" || rm -f "$cached"
done
shopt -u nullglob

case ${1:-} in
  --quit) exec quickshell ipc -p "$runtime_dir" call -- wallet quit ;;
  --status) exec quickshell ipc -p "$runtime_dir" call -- wallet status ;;
  --check) exec quickshell -p "$runtime_dir" ;;
  --preview|--window|--toggle) ;;
  "") ;;
  *) echo 'Usage: cashu-me [--window|--toggle [screen]|--preview|--status|--quit|--check]' >&2; exit 2 ;;
esac

if [[ $CASHU_ME_PREVIEW == 0 && ! -x $CASHU_ME_BACKEND ]]; then
  echo 'Build the wallet worker with cargo build --locked, or use --preview.' >&2
  exit 1
fi

# An existing instance owns the window and the wallet worker.
if quickshell ipc -p "$runtime_dir" call -- wallet "$ipc_method" "${ipc_args[@]}" >/dev/null 2>&1; then
  exit 0
fi
exec quickshell -n -p "$runtime_dir"
