#!/usr/bin/env python3
"""QR input helper. Bearer data only goes to the parent through stdout."""
import fcntl
import glob
import json
import os
import signal
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

child = None

# zbarcam opens /dev/video0 unless told otherwise, and on machines whose
# first node is not a capture device (Apple's ISP exposes metadata first,
# some capture cards expose an output node) it exits at once with "does not
# support usable CAPTURE". VIDIOC_QUERYCAP over each node finds the camera
# without depending on v4l-utils; CASHU_ME_CAMERA names one outright.
VIDIOC_QUERYCAP = 0x80685600
CAP_VIDEO_CAPTURE = 0x00000001
CAP_VIDEO_CAPTURE_MPLANE = 0x00001000
CAP_READWRITE = 0x01000000
CAP_STREAMING = 0x04000000
CAP_DEVICE_CAPS = 0x80000000


def capture_devices():
    chosen = os.environ.get("CASHU_ME_CAMERA")
    if chosen:
        return [chosen]
    found = []
    for node in sorted(glob.glob("/dev/video*"), key=lambda n: int(n[10:]) if n[10:].isdigit() else 999):
        try:
            fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
        except OSError:
            continue
        try:
            answer = bytearray(104)
            fcntl.ioctl(fd, VIDIOC_QUERYCAP, answer)
        except OSError:
            continue
        finally:
            os.close(fd)
        capabilities, device_caps = struct.unpack_from("<II", answer, 84)
        caps = device_caps if capabilities & CAP_DEVICE_CAPS else capabilities
        # Single-plane capture only: zbar reads through the classic
        # capture interface and cannot drive a multi-plane node.
        if caps & CAP_VIDEO_CAPTURE and caps & (CAP_STREAMING | CAP_READWRITE):
            found.append(node)
    return found


def cleanup(signum=None, frame=None):
    if child is not None and child.poll() is None:
        child.terminate()
        try:
            child.wait(timeout=2)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
    if signum is not None:
        # A cancelled scan is not a successful scan. Reporting zero here let a
        # caller checking the exit status treat a killed scanner as a result.
        print(json.dumps({"error": "Scanning was cancelled."}))
        raise SystemExit(1)


def run(command, timeout=60):
    global child
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        output, _ = child.communicate(timeout=timeout)
        if child.returncode != 0:
            raise ValueError("No QR code was read, or scanning was cancelled.")
        try:
            return output.decode("utf-8").strip()
        except UnicodeDecodeError:
            # Never let decoded payload bytes reach the error channel.
            raise ValueError("The QR code did not contain readable text.") from None
    finally:
        cleanup()


# SIGHUP arrives on session teardown. Without a handler the interpreter dies
# without unwinding, stranding the captured QR image and orphaning the child.
for received in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT):
    signal.signal(received, cleanup)
try:
    mode = sys.argv[1]
    if mode == "camera":
        devices = capture_devices()
        if not devices:
            raise ValueError("No camera was found.")
        decoded = run(["zbarcam", "--raw", "--quiet", "--oneshot", "--nodisplay", "--nodbus",
                       "--prescale=640x480", "-Sdisable", "-Sqrcode.enable", devices[0]])
    else:
        with tempfile.TemporaryDirectory(prefix="cashu-me-qr-") as temporary:
            if mode == "screen":
                geometry = run(["slurp"], 30)
                path = Path(temporary) / "capture.png"
                run(["grim", "-g", geometry, str(path)], 10)
            elif mode == "image":
                path = Path(sys.argv[2])
            else:
                raise ValueError("Unknown scanning mode.")
            decoded = run(["zbarimg", "--quiet", "--raw", "--nodbus", "-Sdisable", "-Sqrcode.enable", "--", str(path)], 15)
    lines = decoded.splitlines()
    if len(lines) != 1 or not lines[0] or len(decoded) > 1_048_576:
        raise ValueError("Choose an image or region containing exactly one QR code.")
    print(json.dumps({"text": decoded}))
except (OSError, ValueError, subprocess.TimeoutExpired, IndexError) as error:
    message = str(error) if isinstance(error, ValueError) else "Scanning could not finish. Check the camera or required scanning tools."
    print(json.dumps({"error": message}))
    sys.exit(1)
