#!/usr/bin/env python3
"""QR input helper. Bearer data only goes to the parent through stdout."""
import json
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

child = None


def cleanup(signum=None, frame=None):
    if child is not None and child.poll() is None:
        child.terminate()
        try:
            child.wait(timeout=2)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
    if signum is not None:
        # A cancelled scan is not a successful scan. Reporting zero here let a
        # caller checking the exit status treat a killed scanner as a result.
        print(json.dumps({"error": "Scanning was cancelled."}))
        raise SystemExit(1)


def run(command, timeout=60):
    global child
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        output, _ = child.communicate(timeout=timeout)
        if child.returncode != 0:
            raise ValueError("No QR code was read, or scanning was cancelled.")
        try:
            return output.decode("utf-8").strip()
        except UnicodeDecodeError:
            # Never let decoded payload bytes reach the error channel.
            raise ValueError("The QR code did not contain readable text.") from None
    finally:
        cleanup()


# SIGHUP arrives on session teardown. Without a handler the interpreter dies
# without unwinding, stranding the captured QR image and orphaning the child.
for received in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT):
    signal.signal(received, cleanup)
try:
    mode = sys.argv[1]
    if mode == "camera":
        decoded = run(["zbarcam", "--raw", "--quiet", "--oneshot", "--nodisplay", "--nodbus",
                       "--prescale=640x480", "-Sdisable", "-Sqrcode.enable"])
    else:
        with tempfile.TemporaryDirectory(prefix="cashu-me-qr-") as temporary:
            if mode == "screen":
                geometry = run(["slurp"], 30)
                path = Path(temporary) / "capture.png"
                run(["grim", "-g", geometry, str(path)], 10)
            elif mode == "image":
                path = Path(sys.argv[2])
            else:
                raise ValueError("Unknown scanning mode.")
            decoded = run(["zbarimg", "--quiet", "--raw", "--nodbus", "-Sdisable", "-Sqrcode.enable", "--", str(path)], 15)
    lines = decoded.splitlines()
    if len(lines) != 1 or not lines[0] or len(decoded) > 1_048_576:
        raise ValueError("Choose an image or region containing exactly one QR code.")
    print(json.dumps({"text": decoded}))
except (OSError, ValueError, subprocess.TimeoutExpired, IndexError) as error:
    message = str(error) if isinstance(error, ValueError) else "Scanning could not finish. Check the camera or required scanning tools."
    print(json.dumps({"error": message}))
    sys.exit(1)
